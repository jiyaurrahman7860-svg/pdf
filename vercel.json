{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mytoolspdf.com"
        }
      ],
      "destination": "https://pdf.savefast.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mytoolspdf.com"
        }
      ],
      "destination": "https://pdf.savefast.in/:path*",
      "permanent": true
    }
  ]
}
